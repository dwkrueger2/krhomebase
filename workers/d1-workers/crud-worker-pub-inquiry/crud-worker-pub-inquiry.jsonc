{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "krhomebase-crud-worker-pub-inquiry",
  "main": "./crud-worker-pub-inquiry.ts",
  "compatibility_date": "2026-06-05",
  "secrets": {
    "required": [
      "CRUD_WORKER_PUB_INQUIRY_PRIVATE_KEY"
    ]
  },
  "d1_databases": [
    {
      // Public inquiry quarantine database only. Do not bind the KR Homebase operational D1 database here.
      "binding": "PUBLIC_INQUIRY_DB",
      "database_name": "kr_public_inquiry_06_2026",
      // Set Nov 12, 2026 (Settings plan, stage 4e): the id from `wrangler d1 list`, matching
      // docs/Schema_Public_Inquiry_v2.0/schema_public_inquiry_v2_0.sql. The old live Worker
      // (crud-worker-pub-inquiry, used by the public site) writes the same database.
      "database_id": "8517c8e6-f557-4286-824f-30f01148c325"
    }
  ],
  "kv_namespaces": [
    {
      // Reuses the same PUBLIC_KEYS namespace and JWT kid used by crud-worker.
      // This verifies the trusted server JWT without creating a new server key pair.
      "binding": "PUBLIC_KEYS",
      "id": "f70c0ff65aa148a59bd1d598236ce1de"
    }
  ],
  // No public address (Settings plan, stage 4e): only krhomebase-api calls this copy, through its service binding
  // PUBLIC_INQUIRY_WORKER. The public site keeps using the old Worker by its own address.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "krhomebase-crud-worker-pub-inquiry-dev",
      "secrets": {
        "required": [
          "CRUD_WORKER_PUB_INQUIRY_PRIVATE_KEY"
        ]
      },
      "d1_databases": [
        {
          "binding": "PUBLIC_INQUIRY_DB",
          "database_name": "kr_public_inquiry_dev",
          "database_id": "40ab02b3-d059-44db-97ba-b2a45cd92af2"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "PUBLIC_KEYS",
          "id": "f70c0ff65aa148a59bd1d598236ce1de"
        }
      ],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}

// Not part of the login. Database ids are NOT_SET_REVIEW_BEFORE_USE on purpose (see workers/Readme-workers.md).
// Old commands, kept as a record. Do not run them here.
// Deploy from workers/d1-workers/crud-worker-pub-inquiry:
// pnpm wrangler deploy --config .\crud-worker-pub-inquiry.jsonc
//
// Set the worker-only private decrypt key. This may use the same private key file
// as the existing CRUD worker if you intentionally want to reuse the current
// server/worker key material for this patch:
//
// Get-Content ..\..\..\private\dev-private-keys\private-worker-crud-operations-2.pem -Raw |
//   pnpm wrangler secret put CRUD_WORKER_PUB_INQUIRY_PRIVATE_KEY --config .\crud-worker-pub-inquiry.jsonc
