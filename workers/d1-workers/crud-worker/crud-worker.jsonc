// KR Homebase crud worker (copied from the old repository, then changed for this repository).
// Changes from the copy: Cloudflare name, database, key store id, no public address. The code (crud-worker.ts) is unchanged.
// Live setup and commands: workers/Readme-workers.md. Local run (optional): pnpm dev:crud (port 8791).
{
  "$schema": "../../../node_modules/wrangler/config-schema.json", // schema is for the IDE, not for wrangler.
  "name"              : "krhomebase-crud-worker",
  "main"              : "./crud-worker.ts",
  "compatibility_date": "2026-05-18",
  "secrets"           : {
    "required": [
      "CRUD_WORKER_PRIVATE_KEY"
    ]
  },
  "d1_databases"      : [
    {
      // Cloudflare’s D1 config uses d1_databases, with binding, database_name, and database_id; the binding becomes available on env.<BINDING_NAME>.
      "binding"      : "CRUD_WORKER_ASSIGNED_D1",
      // The database of this repository. It holds a copy of development data that includes client data.
      "database_name": "krhomebase",
      "database_id"  : "ef68921f-c7d3-4d0b-9af4-defebc748616"
      //pnpm wrangler d1 list  to see the database_id
    }
  ],
  "kv_namespaces"     : [
    {
      // Binding: PUBLIC_KEYS
      // Used by: crud-worker.ts (and T1/T2-worker.js for JWT verification)
      // Purpose: public PEM key lookup for JWT verification tests
      // Command to see the KV Keys - pnpm wrangler kv namespace list.  Note title of namespace is just for us humans. The id is what we really bind.
      // This repository's own key store, named krhomebase-public-keys. Not shared with the old workers.
      // It holds the application's public key under the name public-dev-dan-2.pem.
      "binding": "PUBLIC_KEYS",
      "id"     : "f70c0ff65aa148a59bd1d598236ce1de"
    }
  ],
  // No public web address (decision of Nov 4, 2026). This Worker can write to most tables, so only
  // another Worker (apps/api) may call it, through a service binding.
  "workers_dev"       : false,
  "preview_urls"      : false,
  "env": {
    "dev": {
      "name": "krhomebase-crud-worker-dev",
      "secrets": {
        "required": [
          "CRUD_WORKER_PRIVATE_KEY"
        ]
      },
      "d1_databases": [
        {
          "binding": "CRUD_WORKER_ASSIGNED_D1",
          "database_name": "krhomebase",
          "database_id": "ef68921f-c7d3-4d0b-9af4-defebc748616"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "PUBLIC_KEYS",
          "id": "f70c0ff65aa148a59bd1d598236ce1de"
        }
      ],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
// Example Installation of the Worker
//pnpm wrangler deploy --config .\crud-worker.jsonc
// (Recorded from the old repository. Do not run it here. Deploying is not part of the migration.)
//
