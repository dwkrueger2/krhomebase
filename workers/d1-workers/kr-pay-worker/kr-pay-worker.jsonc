//file: workers/d1-workers/kr-pay-worker/kr-pay-worker.jsonc
// KR Pay Worker, live: kr-pay-worker-live serves pay.krhomebase.com from the one database, krhomebase (README.md in this folder).
// It replaces the old kr-pay-worker-dev, which wrote to the frozen krhomebase_dev (docs/06_Contacts_Billing_Port_Plan.md, section 6).
//   One deployment, no --env. Both Stripe environments are served by the same Worker:
//     the payment_request row's stored environment picks the API key, and the webhook path
//     (/stripe/webhook/sandbox or /stripe/webhook/live) picks the webhook secret.
//   KR_PAY_ENVIRONMENT is only the fallback label for pages that have no payment request (for example "Page not found").
// Stripe keys come from D1 payment_provider (Settings → Stripe Payment Configuration), never from this file.
// One Worker secret: KR_PAYMENT_PROVIDER_KEK, the same KEK that encrypted the payment_provider rows (copied with the database).
// Optional Worker secret: KR_HOMEBASE_PAY_WEBHOOK_URL. Leave it unset until the new app has its pay-link-paid route (plan stage 6);
//   until then a paid link stays "paid" in krhomebase and is posted when billing reads it.
// Version: every response carries the repository track (root package.json) and the Cloudflare deployment id (CF_VERSION_METADATA).
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "kr-pay-worker-live",
  "main": "./kr-pay-worker.ts",
  "compatibility_date": "2026-09-05",
  "secrets": {
    "required": ["KR_PAYMENT_PROVIDER_KEK"]
  },
  "d1_databases": [
    {
      // The one database. The Worker runs only the fixed statements in kr-pay-worker.ts.
      "binding": "KR_PAY_D1",
      "database_name": "krhomebase",
      "database_id": "ef68921f-c7d3-4d0b-9af4-defebc748616"
    }
  ],
  // Cloudflare fills this in at run time with the id, tag and time of the deployment that answered.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "KR_PAY_ENVIRONMENT": "live"
  },
  // Moving this address from kr-pay-worker-dev: Wrangler asks during the first deploy whether to point it at this Worker. Answer yes.
  "routes": [{ "pattern": "pay.krhomebase.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
