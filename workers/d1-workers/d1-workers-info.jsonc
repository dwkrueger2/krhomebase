      ],
      "deployCommand": "pnpm wrangler deploy --config .\\workers\\d1-workers\\article-read-worker\\article-read-worker.jsonc",
      "verifyCommand": "pnpm wrangler deployments list --name kr-article-read-worker",
      "notes": [
        "Used by public article/answer rendering path.",
        "Confirm article D1 database id before redeploying."
      ]
    },
