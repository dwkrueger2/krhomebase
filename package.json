{
  "name": "krhomebase",
  "version": "1.2.0",
  "patchNum": "3",
  "patchDate": "11-18",
  "private": true,
  "description": "KR Homebase: web (Next.js on vinext) and api (Hono on Cloudflare Workers).",
  "type": "module",
  "scripts": {
    "dev": "pnpm --reporter=append-only run \"/^dev:(api|web)$/\"",
    "dev:web": "pnpm --dir apps/web run dev",
    "dev:api": "pnpm --dir apps/api run dev",
    "dev:external": "pnpm --dir apps/external-api run dev",
    "dev:feedback-viewer": "pnpm --dir workers/feedback-viewer run dev",
    "dev:feedback-viewer:worker": "pnpm --dir workers/feedback-viewer run dev:worker",
    "dev:crud": "wrangler dev --config workers/d1-workers/crud-worker/crud-worker.jsonc --port 8791 --inspector-port 9340 --persist-to workers/.wrangler/shared-state",
    "dev:session": "wrangler dev --config workers/d1-workers/session-worker/session-worker.jsonc --port 8792 --inspector-port 9341 --persist-to workers/.wrangler/shared-state",
    "build": "pnpm run build:web",
    "build:web": "pnpm --dir apps/web run build",
    "deploy:api": "pnpm --dir apps/api run deploy",
    "deploy:web": "pnpm --dir apps/web run deploy",
    "deploy:external": "pnpm --dir apps/external-api run deploy",
    "deploy:pay": "wrangler deploy --config workers/d1-workers/kr-pay-worker/kr-pay-worker.jsonc",
    "deploy:feedback-viewer": "pnpm --dir workers/feedback-viewer run deploy",
    "deploy:public-article": "wrangler deploy --config workers/r2-workers/public-article-worker/public-article-worker.jsonc",
    "deploy:hot": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-Krhomebase.ps1 -Mode hot",
    "deploy:warn": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-Krhomebase.ps1 -Mode warn",
    "deploy:hotDelay3": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-Krhomebase.ps1 -Mode warn 3",
    "deploy:hotDelay5": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-Krhomebase.ps1 -Mode warn 5",
    "deploy:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-Krhomebase.ps1 -Mode status",
    "deploy:finish": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-Krhomebase.ps1 -Mode finish",
    "deploy:cancel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-Krhomebase.ps1 -Mode cancel",
    "typecheck": "pnpm --dir packages/contracts run typecheck && pnpm --dir packages/tool-sdk run typecheck && pnpm --dir packages/documents run typecheck && pnpm --dir apps/api run typecheck && pnpm --dir apps/external-api run typecheck && pnpm --dir workers/feedback-viewer run typecheck && pnpm --dir apps/web run typecheck",
    "test": "pnpm --dir packages/contracts run test && pnpm --dir packages/tool-sdk run test && pnpm --dir packages/documents run test && pnpm --dir apps/api run test && pnpm --dir apps/external-api run test && pnpm --dir workers/feedback-viewer run test && pnpm --dir apps/web run test",
    "check": "pnpm run typecheck && pnpm run test",
    "openapi": "pnpm --dir apps/api run openapi:write",
    "documents:css": "pnpm --dir packages/documents run css",
    "types:cf": "pnpm --dir apps/api run types:cf",
    "pack:tool-sdk": "pnpm --dir packages/tool-sdk run pack",
    "snapshot:order": "node scripts/snapshot/order-data.mjs",
    "feedback:get": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Get-Feedback.ps1",
    "stop:port:3000": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 3000",
    "stop:port:3001": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 3001",
    "stop:port:3011": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 3011",
    "stop:port:3002": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 3002",
    "stop:port:3003": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 3003",
    "stop:port:5174": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 5174",
    "stop:port:8787": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 8787",
    "stop:port:9339": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 9339",
    "stop:port:8791": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 8791",
    "stop:port:8792": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 8792",
    "stop:port:8793": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 8793",
    "stop:port:9340": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 9340",
    "stop:port:9341": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 9341",
    "stop:port:9342": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 9342",
    "stop:port:9343": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-port.windows.ps1 -Port 9343",
    "stop:dev:servers": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-servers.windows.ps1",
    "stop:ports:all": "pnpm run stop:dev:servers && pnpm run stop:port:3000 && pnpm run stop:port:3001 && pnpm run stop:port:3002 && pnpm run stop:port:3003 && pnpm run stop:port:3011 && pnpm run stop:port:5174 && pnpm run stop:port:8787 && pnpm run stop:port:9339 && pnpm run stop:port:8791 && pnpm run stop:port:8792 && pnpm run stop:port:8793 && pnpm run stop:port:9340 && pnpm run stop:port:9341 && pnpm run stop:port:9342 && pnpm run stop:port:9343",
    "listScripts": "pnpm pkg get scripts",
    "repo-root": "git rev-parse --show-toplevel"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.16.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "wrangler": "^4.156.2"
  }
}
