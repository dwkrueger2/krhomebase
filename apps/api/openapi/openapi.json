    "/v1/auth/google/callback": {
      "get": {
        "summary": "Finish Google sign-in: check the answer, admit the person and open a session.",
        "description": "Public (no sign-in).\n\nSide effects: Calls Google (token exchange and signing keys); Calls the CRUD Worker: reads user, user_sso_identity, user_invite; writes individual, individual_contact_method, user, user_sso_identity, user_invite, employee, kr_session, kr_homebase_initialization; Sets the session cookie.\n\nError codes: VALIDATION_FAILED, INTERNAL_ERROR.",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "One-time code from Google."
            },
            "required": false,
            "description": "One-time code from Google.",
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "The state value Google sends back."
            },
            "required": false,
            "description": "The state value Google sends back.",
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Google error code when the person declined or Google refused."
            },
            "required": false,
            "description": "Google error code when the person declined or Google refused.",
            "name": "error",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to / when signed in, or to /login?auth_error=<code>."
          },
          "422": {
            "description": "The request did not match the contract (VALIDATION_FAILED).",
