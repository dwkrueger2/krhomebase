    "/v1/auth/session": {
      "get": {
        "summary": "Return the signed-in person for the current session cookie.",
        "description": "Any signed-in user.\n\nSide effects: Updates last_seen_at on the session through the Session Worker.\n\nError codes: UNAUTHENTICATED, FORBIDDEN, SESSION_VALIDATION_UNAVAILABLE, INTERNAL_ERROR.",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "The current session.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "session": {
                          "type": "object",
                          "properties": {
                            "sessionId": {
                              "type": "string",
                              "description": "Id of the session row."
                            },
                            "userId": {
                              "type": "string",
                              "description": "Id of the user account."
                            },
                            "displayName": {
                              "type": "string",
                              "description": "Name to show for the person."
                            },
                            "email": {
                              "type": "string",
                              "description": "Login email address."
                            },
                            "role": {
                              "type": "string",
                              "description": "Role stored on the user account."
                            },
                            "firmName": {
                              "type": "string",
                              "description": "Firm name for the account block."
                            },
                            "avatarInitials": {
                              "type": "string",
                              "description": "Two to four letters for the avatar circle."
                            },
                            "expiresAt": {
                              "type": "string",
                              "description": "When the session ends (ISO time)."
                            },
                            "mfaVerified": {
                              "type": "boolean",
                              "description": "True when a second step was already satisfied."
                            }
                          },
                          "required": [
                            "sessionId",
                            "userId",
                            "displayName",
                            "email",
                            "role",
                            "firmName",
                            "avatarInitials",
                            "expiresAt",
                            "mfaVerified"
                          ],
                          "description": "The current signed-in session."
                        }
                      },
                      "required": [
                        "session"
                      ]
                    },
                    "requestId": {
                      "type": "string"
