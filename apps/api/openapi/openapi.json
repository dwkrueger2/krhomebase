    "/v1/auth/turnstile/verify": {
      "post": {
        "summary": "Check the Cloudflare human-check token and remember a pass for five minutes.",
        "description": "Public (no sign-in).\n\nSide effects: Calls Cloudflare Turnstile siteverify; Sets the kr_turnstile_verified cookie.\n\nError codes: VALIDATION_FAILED, TURNSTILE_VALIDATION_FAILED, TURNSTILE_UNAVAILABLE, AUTH_NOT_CONFIGURED, INTERNAL_ERROR.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The one-time token the Turnstile widget gave the browser."
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The check passed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "verified": {
                          "type": "boolean",
                          "enum": [
                            true
                          ],
                          "description": "Always true; a failed check is an error reply."
                        },
                        "hostname": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Host name Cloudflare saw the widget on."
                        },
                        "action": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Action label the widget was rendered with."
                        }
                      },
                      "required": [
                        "verified",
                        "hostname",
                        "action"
                      ]
                    },
                    "requestId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "data",
                    "requestId"
                  ]
                }
