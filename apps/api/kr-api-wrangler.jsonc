{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krhomebase-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // No public address. Only other Workers can call this one, through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Service bindings: the only way this Worker reaches the two sign-in Workers (they have no public address).
  // "remote": true makes `wrangler dev` (pnpm dev:api) call the deployed Workers instead of local copies; it has no effect on a deployed API.
  "services": [
    {
      "binding": "CRUD_WORKER",
      "service": "krhomebase-crud-worker",
      "remote": true
    },
    {
      "binding": "SESSION_WORKER",
      "service": "krhomebase-session-worker",
      "remote": true
    },
    // The public inquiry CRUD Worker: the only door to the quarantined public inquiry database (site feedback;
    // Settings plan, stage 4e). Deployed by the requester Nov 12, 2026; "remote": true makes `pnpm dev:api` call the
    // deployed Worker, so a feedback change made while testing locally changes the live public inquiry database.
    {
      "binding": "PUBLIC_INQUIRY_WORKER",
      "service": "krhomebase-crud-worker-pub-inquiry",
      "remote": true
    }
  ],
  // Plain (non-secret) settings for the live site. On this computer, apps/api/.dev.vars overrides them
  // (KR_APP_BASE_URL becomes http://localhost:3011). The secrets are not here: they are set with
  // `wrangler secret put` (see apps/api/Readme-auth.md).
  "vars": {
    // Google OAuth client "krhomebase-team". The client ID is public (it appears in the Google sign-in address).
    "KR_GOOGLE_CLIENT_ID": "853554586739-66ut709ojhm6647kb789a9n1vmu1sc9p.apps.googleusercontent.com",
    // The address the browser uses for the app. Google sends the person back to <this>/api/v1/auth/google/callback.
    "KR_APP_BASE_URL": "https://krhomebase.com",
    "KR_FIRM_NAME": "Krueger & Richard",
    "KR_SESSION_COOKIE_NAME": "kr_session",
    // Name of the app's public key in the crud-worker's KV store (krhomebase-public-keys).
    "KR_WORKER_JWT_KEY_ID": "public-dev-dan-2.pem",
    // Cloudflare Turnstile. The site key below is the public key of the widget "krhomebase-ts-widget"; its matching
    // secret is the KR_TURNSTILE_SECRET_KEY secret (set with `wrangler secret put`). The commented line is Cloudflare's
    // published "always passes" test site key, kept for reference (it only works with the matching test secret).
    "KR_TURNSTILE_REQUIRED": "true",
    //    "KR_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "KR_TURNSTILE_SITE_KEY": "0x4AAAAAADcWsYVlFL36jozU",
    // Only used while the database has no users: lets the email in KR_SUPER_ADMIN_EMAILS (a secret) create the first super admin.
    "KR_BOOTSTRAP_FIRST_SSO_USER_AS_SUPER_ADMIN": "true",
    // Google Workspace mailer (src/platform/googleWorkspaceMailer.ts; Settings plan stage 4d). Copied from the old
    // apps/kr-homebase/.env, none secret. The key is the secret KR_GOOGLE_WORKSPACE_MAILER_PRIVATE_KEY (the whole JSON key file).
    // SENDER_EMAIL is the Workspace user the service account signs in as; groups work only as Reply-To.
    "KR_GOOGLE_WORKSPACE_MAILER_CLIENT_EMAIL": "kr-homebase-mailer@krhomebase.iam.gserviceaccount.com",
    "KR_GOOGLE_WORKSPACE_SENDER_EMAIL": "onboarding@legaldrive.net",
    "KR_GOOGLE_WORKSPACE_SENDER_NAME": "Krueger & Richard",
    "KR_GOOGLE_WORKSPACE_REPLY_TO": "info@legaldrive.net",
    "KR_GOOGLE_WORKSPACE_BILLING_SENDER_EMAIL": "onboarding@legaldrive.net",
    "KR_GOOGLE_WORKSPACE_BILLING_SENDER_NAME": "Krueger & Richard Billing",
    "KR_GOOGLE_WORKSPACE_BILLING_REPLY_TO": "billing@kruegerrichard.com",
    "KR_GOOGLE_WORKSPACE_FIRM_SENDER_EMAIL": "onboarding@legaldrive.net",
    "KR_GOOGLE_WORKSPACE_FIRM_SENDER_NAME": "Krueger & Richard",
    "KR_GOOGLE_WORKSPACE_FIRM_REPLY_TO": "firm@kruegerrichard.com"
  },
  // "remote": true makes `wrangler dev` (pnpm dev:api) use the live krhomebase database, not an empty local one.
  // It has no effect on a deployed API. Requester's decision, Nov 9, 2026, while every contacts route only reads.
  // Revisit before contact saves are built (plan stage 1d): with this on, a save made while testing locally changes live data.
  "d1_databases": [
    {
      "binding": "krhomebase",
      "database_name": "krhomebase",
      "database_id": "ef68921f-c7d3-4d0b-9af4-defebc748616",
      "remote": true
    }
  ]
}
